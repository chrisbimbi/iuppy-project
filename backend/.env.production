NODE_ENV=production

# DB (ajuste conforme seu ambiente)
DB_HOST=localhost
DB_PORT=5433
DB_USER=iuppy_admin
DB_PASS=Iuppy#2025
DB_NAME=iuppy_dev

# API
API_PORT=3000
API_GLOBAL_PREFIX=
# múltiplas origens separadas por vírgula
CMS_ORIGIN=https://cms.seu-dominio.com,https://app.seu-dominio.com

# JWT
JWT_ACCESS_SECRET=troque-por-um-segredo-forte
JWT_REFRESH_SECRET=troque-por-um-segredo-muito-forte
JWT_ACCESS_TTL=48h
JWT_REFRESH_TTL=90d

# Cookies do refresh (prod, cross-site exige HTTPS + SameSite=None)
REFRESH_COOKIE_SAMESITE=none
REFRESH_COOKIE_SECURE=true
# use domínio de 2º nível com ponto à esquerda p/ subdomínios
COOKIE_DOMAIN=.seu-dominio.com

# Firebase (admin SDK)
FIREBASE_PROJECT_ID=iuppy-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@iuppy-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Deeplink/Weblink (PROD)
APP_NEWS_DEEPLINK_TEMPLATE=iuppy://news/article/:id
APP_NEWS_WEBLINK_TEMPLATE=https://app.seu-dominio.com/news/article/:id

# (legado – opcional)
NEWS_WEB_BASE_URL=https://app.seu-dominio.com
NEWS_DEEPLINK_PATH=/contents
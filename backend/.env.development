NODE_ENV=development

# DB (docker)
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=iuppy_admin
DB_PASSWORD=Iuppy#2025
DB_NAME=iuppy_dev

# API
API_PORT=3000
API_GLOBAL_PREFIX=
# pode ser uma lista separada por vírgula (ex.: http://localhost:5173,http://127.0.0.1:5173)
CMS_ORIGIN=http://localhost:5173

# JWT
JWT_ACCESS_SECRET=dev-access-secret
JWT_REFRESH_SECRET=dev-refresh-secret
# TTLs
JWT_ACCESS_TTL=48h
JWT_REFRESH_TTL=30d

# Cookies do refresh (dev)
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_SECURE=false
# deixe sem domain em dev (ports diferentes). Se quiser, descomente e ajuste:
# COOKIE_DOMAIN=localhost

# Firebase (admin SDK)
GOOGLE_APPLICATION_CREDENTIALS=/usr/src/app/creds/firebase-admin.json
FIREBASE_PROJECT_ID=iuppy-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@iuppy-app.iam.gserviceaccount.com
# (se usar chave inline em dev, pode adicionar FIREBASE_PRIVATE_KEY)

# Deeplink/Weblink (DEV)
APP_NEWS_DEEPLINK_TEMPLATE=iuppydev://news/article/:id
APP_NEWS_WEBLINK_TEMPLATE=http://localhost:5173/news/article/:id

# (legado – opcional)
NEWS_WEB_BASE_URL=http://localhost:5173
NEWS_DEEPLINK_PATH=/contents
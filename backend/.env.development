NODE_ENV=development

# ===== DB (docker) =====
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USERNAME=iuppy_admin
DB_PASSWORD="Iuppy#2025"
DB_NAME=iuppy_dev

# ===== Redis (Docker uses override in compose, Local uses this) =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ===== API =====
API_PORT=4000
API_GLOBAL_PREFIX=
CMS_ORIGIN=http://localhost:5173

# ===== JWT =====
JWT_ACCESS_SECRET=dev-access-secret
JWT_REFRESH_SECRET=dev-refresh-secret
JWT_ACCESS_TTL=48h
JWT_REFRESH_TTL=30d

# ===== Cookies do refresh (dev) =====
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_SECURE=false
# COOKIE_DOMAIN=localhost

# ===== Firebase (admin SDK) =====
GOOGLE_APPLICATION_CREDENTIALS=./creds/firebase-admin.json
FIREBASE_PROJECT_ID=iuppy-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@iuppy-app.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY=...  # se precisar inline

# ===== News deeplink/weblink (DEV) =====
APP_NEWS_DEEPLINK_TEMPLATE=iuppydev://news/article/:id
APP_NEWS_WEBLINK_TEMPLATE=http://localhost:5173/news/article/:id
NEWS_WEB_BASE_URL=http://localhost:5173
NEWS_DEEPLINK_PATH=/news/article


# ===== EMAIL (Gmail, autenticando como você e mandando do alias) =====
MAIL_ENABLED=1
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=christiano@iuppy.com.br
MAIL_PASS=bapg rqiw pygd tofy
MAIL_FROM="Iuppy Forms <comunicacao@iuppy.com.br>"
MAIL_REPLY_TO="comunicacao@iuppy.com.br"

# ===== FORMS REMINDERS =====
FORMS_REMINDERS_ENABLED=1
DEFAULT_TZ=America/Sao_Paulo

# ===== FCM (seu código usa) =====
FCM_ANDROID_CHANNEL_ID=news_channel
FCM_WEB_ICON=

# =================================================================
# ===== INTEGRATIONS & IA CONFIGURATION (Real World) =============
# =================================================================
#
# Copie os valores obtidos seguindo o Guia:
# artifacts/integration_setup_guide.md

# --- 1. Google Cloud / Vertex AI ---
GOOGLE_PROJECT_ID=
GOOGLE_LOCATION=us-central1
# Se usou secrets/google-credentials.json, deixe como está abaixo:
# GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/google-credentials.json
# (Nota: se rodar localmente fora do Docker, use caminho absoluto ou relativo ao backend)

# --- 2. ADP Workforce Now ---
ADP_CLIENT_ID=
ADP_CLIENT_SECRET=
ADP_TOKEN_URL=https://accounts.adp.com/auth/oauth/v2/token
ADP_CERT_PATH=./../secrets/adp_signed.pem
ADP_KEY_PATH=./../secrets/adp.key

# --- 3. Microsoft Graph ---
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# --- 4. SMTP (SendGrid) ---
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=
SMTP_FROM=no-reply@iuppy.com


@@ -0,0 +1,145 @@
+import { Injectable } from '@nestjs/common';
+import { InjectRepository } from '@nestjs/typeorm';
+import { In, Repository } from 'typeorm';
+import { UserDeviceEntity } from '../notifications/entities/user-device.entity';
+import { AudienceMode } from '@shared/types/NewsSettings';
+import { CompanyEntity } from '../companies/company.entity';
+import { SpaceEntity } from '../spaces/space.entity';
+import { Channel } from '../channels/channel.entity';
+import { GroupEntity } from '../groups/group.entity';
+import { UserEntity } from '../users/user.entity';
+
+@Injectable()
+export class AudienceResolverService {
+  constructor(
+    @InjectRepository(UserDeviceEntity)
+    private readonly userDeviceRepo: Repository<UserDeviceEntity>,
+    @InjectRepository(CompanyEntity)
+    private readonly companyRepo: Repository<CompanyEntity>,
+    @InjectRepository(SpaceEntity)
+    private readonly spaceRepo: Repository<SpaceEntity>,
+    @InjectRepository(Channel)
+    private readonly channelRepo: Repository<Channel>,
+    @InjectRepository(GroupEntity)
+    private readonly groupRepo: Repository<GroupEntity>,
+    @InjectRepository(UserEntity)
+    private readonly userRepo: Repository<UserEntity>,
+  ) {}
+
+  async resolve(companyId: string, mode: AudienceMode, params: Record<string, any>): Promise<string[]> {
+    let userIds: string[] = [];
+
+    switch (mode) {
+      case AudienceMode.COMPANY:
+        // COMPANY: todos os usuários ativos da empresa.
+        const companyUsers = await this.userRepo.find({
+          where: { companyId, isActive: true }, // Assuming isActive field exists
+          select: ['id'],
+        });
+        userIds = companyUsers.map(user => user.id);
+        break;
+
+      case AudienceMode.SPACE:
+        // SPACE: união dos usuários membros dos grupos-alvo do space.
+        const spaceId = params.spaceId;
+        if (!spaceId) throw new Error('Space ID is required for SPACE mode.');
+
+        const space = await this.spaceRepo.findOne({
+          where: { id: spaceId, companyId },
+        });
+        if (!space || !space.targetGroupIds || space.targetGroupIds.length === 0) {
+          return []; // No target groups or space not found
+        }
+
+        const spaceGroups = await this.groupRepo.find({
+          where: { id: In(space.targetGroupIds), companyId },
+          relations: ['members'], // Load members relation
+        });
+        spaceGroups.forEach(group => {
+          userIds.push(...group.members.map(member => member.id));
+        });
+        break;
+
+      case AudienceMode.CHANNEL:
+        // CHANNEL: união dos usuários dos grupos ligados ao channel e dos grupos-alvo de cada space associado ao channel.
+        const channelIds = params.channelIds;
+        if (!channelIds || channelIds.length === 0) throw new Error('Channel IDs are required for CHANNEL mode.');
+
+        const channels = await this.channelRepo.find({
+          where: { id: In(channelIds), companyId },
+        });
+
+        for (const channel of channels) {
+          // Users from groups directly linked to the channel
+          if (channel.groupIds && channel.groupIds.length > 0) {
+            const channelGroups = await this.groupRepo.find({
+              where: { id: In(channel.groupIds), companyId },
+              relations: ['members'],
+            });
+            channelGroups.forEach(group => {
+              userIds.push(...group.members.map(member => member.id));
+            });
+          }
+
+          // Users from target groups of spaces associated with the channel
+          if (channel.spaceIds && channel.spaceIds.length > 0) {
+            const associatedSpaces = await this.spaceRepo.find({
+              where: { id: In(channel.spaceIds), companyId },
+            });
+            for (const associatedSpace of associatedSpaces) {
+              if (associatedSpace.targetGroupIds && associatedSpace.targetGroupIds.length > 0) {
+                const spaceTargetGroups = await this.groupRepo.find({
+                  where: { id: In(associatedSpace.targetGroupIds), companyId },
+                  relations: ['members'],
+                });
+                spaceTargetGroups.forEach(group => {
+                  userIds.push(...group.members.map(member => member.id));
+                });
+              }
+            }
+          }
+        }
+        break;
+
+      case AudienceMode.GROUPS:
+        // GROUPS: união dos usuários nos grupos informados.
+        const groupIds = params.groupIds;
+        if (!groupIds || groupIds.length === 0) throw new Error('Group IDs are required for GROUPS mode.');
+
+        const selectedGroups = await this.groupRepo.find({
+          where: { id: In(groupIds), companyId },
+          relations: ['members'],
+        });
+        selectedGroups.forEach(group => {
+          userIds.push(...group.members.map(member => member.id));
+        });
+        break;
+
+      default:
+        throw new Error(`Audience mode ${mode} not supported.`);
+    }
+
+    // Ensure unique user IDs
+    return [...new Set(userIds)];
+  }
+
+  async probe(companyId: string, mode: AudienceMode, params: Record<string, any>): Promise<{ totalUsuarios: number; comTokenAtivo: number; mode: AudienceMode; identifiers: Record<string, any> }> {
+    const eligibleUserIds = await this.resolve(companyId, mode, params);
+
+    const usersWithActiveTokens = await this.userDeviceRepo
+      .createQueryBuilder('device')
+      .select('DISTINCT device.userId')
+      .where('device.companyId = :companyId', { companyId })
+      .andWhere('device.userId IN (:...eligibleUserIds)', { eligibleUserIds })
+      .andWhere('device.enabled = :enabled', { enabled: true })
+      .getRawMany();
+
+    return {
+      totalUsuarios: eligibleUserIds.length,
+      comTokenAtivo: usersWithActiveTokens.length,
+      mode: mode,
+      identifiers: params,
+    };
+  }
+}
+

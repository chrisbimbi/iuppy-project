+    channelRepo = module.get<Repository<Channel>>(getRepositoryToken(Channel));
+    groupRepo = module.get<Repository<GroupEntity>>(getRepositoryToken(GroupEntity));
+    userRepo = module.get<Repository<UserEntity>>(getRepositoryToken(UserEntity));

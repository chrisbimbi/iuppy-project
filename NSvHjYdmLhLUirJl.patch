diff --git a/iuppy_app/lib/features/news/providers/news_interaction_provider.dart b/iuppy_app/lib/features/news/providers/news_interaction_provider.dart
new file mode 100644
index 00000000..119007dc
--- /dev/null
+++ b/iuppy_app/lib/features/news/providers/news_interaction_provider.dart
@@ -0,0 +1,62 @@
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:iuppy_app/data/api_service.dart'; // Assuming ApiService exists for backend calls
+
+class NewsInteractionProvider extends StateNotifier<void> {
+  final ApiService _apiService;
+  final String newsId;
+  DateTime? _lastOpenSentAt; // de-bounce for /open
+  bool _firstOpenSent = false; // ensures "push-open-once"
+
+  NewsInteractionProvider(this._apiService, this.newsId) : super(null);
+
+  Future<void> sendOpen({required String companyId, String? userId, Map<String, dynamic>? meta}) async {
+    final now = DateTime.now();
+    // Implement client-side deduplication for OPEN events
+    if (_lastOpenSentAt != null && now.difference(_lastOpenSentAt!).inSeconds < 5) {
+      print('[NewsInteractionProvider] sendOpen skipped (debounced)');
+      return;
+    }
+    _lastOpenSentAt = now;
+
+    // Ensure first push-origin open is sent only once
+    if (meta?['origin'] == 'push' && _firstOpenSent) {
+      print('[NewsInteractionProvider] sendOpen skipped (first push open already sent)');
+      return;
+    }
+    if (meta?['origin'] == 'push') {
+      _firstOpenSent = true;
+    }
+
+    try {
+      final tzOffsetMinutes = DateTime.now().timeZoneOffset.inMinutes;
+      await _apiService.post(
+        '/v2/interactions/event',
+        {
+          'companyId': companyId,
+          'newsId': newsId,
+          'userId': userId,
+          'type': 'OPEN',
+          'meta': {
+            ...?meta,
+            'tzOffsetMinutes': tzOffsetMinutes,
+          },
+        },
+      );
+      print('[NewsInteractionProvider] OPEN event sent for newsId: $newsId, userId: $userId');
+    } catch (e) {
+      print('[NewsInteractionProvider] Error sending OPEN event: $e');
+    }
+  }
+
+  // Other interaction methods like acknowledge, react, comment, share can be moved here
+  // For now, focusing on OPEN event deduplication
+}
+
+// Provider for NewsInteractionProvider
+final newsInteractionProvider = StateNotifierProvider.family<NewsInteractionProvider, void, String>(
+  (ref, newsId) {
+    final apiService = ref.watch(apiServiceProvider);
+    return NewsInteractionProvider(apiService, newsId);
+  },
+);
+

+          await transactionalEntityManager.save(audienceEntity);
+        } catch (error) {
+          // Log or handle duplicate entry if the constraint is not set to DO NOTHING
+          console.warn(`Duplicate news audience entry for newsId ${newsId}, userId ${audienceEntity.userId}`);
+        }
+      }
+    });
+
+    // 3. Enqueue push notifications for users with active tokens
+    const usersWithActiveTokens = await this.userDeviceRepo

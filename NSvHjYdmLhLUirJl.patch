+  async resendToUnopened(newsId: string, companyId: string): Promise<News> {
+    const news = await this.newsRepo.findOneBy({ id: newsId, companyId });
+    if (!news) {
+      throw new NotFoundException(`News with ID ${newsId} not found.`);
+    }
+
+    if (!news.isPublished) {
+      throw new Error('News must be published to be resent.');
+    }
+
+    // Get all users who were part of the original audience
+    const originalAudience = await this.newsAudienceRepo.find({
+      where: { newsId, companyId },
+      select: ['userId'],
+    });
+    const originalUserIds = originalAudience.map(na => na.userId);
+
+    if (originalUserIds.length === 0) {
+      return news; // No original audience to resend to
+    }
+
+    // Get users who have already opened this news
+    const openedUsers = await this.interactionEventRepo.find({
+      where: {
+        newsId,
+        companyId,
+        type: 'OPEN',
+        userId: In(originalUserIds),
+      },
+      select: ['userId'],
+    });
+    const openedUserIds = new Set(openedUsers.map(event => event.userId));
+
+    // Filter for users who have not opened the news yet
+    const unopenedUserIds = originalUserIds.filter(userId => !openedUserIds.has(userId));
+
+    if (unopenedUserIds.length === 0) {
+      return news; // Everyone has opened it
+    }
+
+    // Get devices with active tokens for unopened users
+    const devicesForUnopenedUsers = await this.userDeviceRepo
+      .createQueryBuilder('device')
+      .select('DISTINCT device.userId')
+      .where('device.companyId = :companyId', { companyId })
+      .andWhere('device.userId IN (:...unopenedUserIds)', { unopenedUserIds })
+      .andWhere('device.enabled = :enabled', { enabled: true })
+      .getRawMany();
+
+    const usersToResend = devicesForUnopenedUsers.map(device => device.userId);
+
+    if (usersToResend.length === 0) {
+      return news; // No users with active tokens to resend to
+    }
+
+    // Create push deliveries for resend batch
+    const resendDeliveries = usersToResend.map(userId =>
+      this.pushDeliveryRepo.create({
+        companyId,
+        newsId,
+        userId,
+        status: 'queued', // Initial status
+        channel: 'news_resend', // Custom channel for news resend
+        // TODO: Add provider, token, meta based on actual push service integration
+        // Log a resend batch for traceability (as per briefing)
+        meta: { resendBatch: new Date().toISOString() },
+      }),
+    );
+    await this.pushDeliveryRepo.save(resendDeliveries);
+
+    return news;
+  }

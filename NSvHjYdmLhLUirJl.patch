+  async publish(newsId: string, companyId: string): Promise<News> {
+    const news = await this.newsRepo.findOneBy({ id: newsId, companyId });
+    if (!news) {
+      throw new NotFoundException(`News with ID ${newsId} not found.`);
+    }
+
+    if (news.isPublished) {
+      throw new Error('News is already published.');
+    }
+
+    const { audienceMode, audienceSpaceId, audienceChannelIds, audienceGroupIds } = news.settings;
+    if (!audienceMode) {
+      throw new Error('Audience mode not set for this news.');
+    }
+
+    const params: Record<string, any> = {};
+    if (audienceSpaceId) params.spaceId = audienceSpaceId;
+    if (audienceChannelIds) params.channelIds = audienceChannelIds;
+    if (audienceGroupIds) params.groupIds = audienceGroupIds;
+
+    // 1. Resolve audience and create snapshot
+    const audienceProbeResult = await this.audienceResolverService.probe(
+      companyId,
+      audienceMode,
+      params,
+    );
+
+    news.settings.audienceSnapshot = {
+      totalUsuarios: audienceProbeResult.totalUsuarios,
+      comTokenAtivo: audienceProbeResult.comTokenAtivo,
+      mode: audienceMode,
+      identifiers: params,
+    };
+    news.isPublished = true;
+    news.publishedAt = new Date();
+
+    // 2. Materialize audience
+    const eligibleUserIds = await this.audienceResolverService.resolve(companyId, audienceMode, params);
+    const newsAudienceEntities = eligibleUserIds.map(userId =>
+      this.newsAudienceRepo.create({
+        companyId,
+        newsId,
+        userId,
+        origemDaRegra: audienceMode, // Store the rule origin
+      }),
+    );
+
+    // Use transaction for idempotency and atomicity
+    await this.newsRepo.manager.transaction(async transactionalEntityManager => {
+      // Save news with updated settings and published status
+      await transactionalEntityManager.save(news);
+
+      // Insert audience, handling duplicates (ON CONFLICT DO NOTHING will be handled by TypeORM for unique constraints)
+      // For now, a simple save, assuming unique constraint on (companyId, newsId, userId) in NewsAudienceEntity

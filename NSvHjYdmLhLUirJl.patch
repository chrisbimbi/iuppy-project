+    service = module.get<AudienceResolverService>(AudienceResolverService);
+    userDeviceRepo = module.get<Repository<UserDeviceEntity>>(getRepositoryToken(UserDeviceEntity));
+    companyRepo = module.get<Repository<CompanyEntity>>(getRepositoryToken(CompanyEntity));

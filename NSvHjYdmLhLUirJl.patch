+    it('should resolve for COMPANY mode', async () => {
+      mockUserRepo.find.mockResolvedValueOnce([{ id: 'user-1' }, { id: 'user-2' }]);
+      const result = await service.resolve(companyId, AudienceMode.COMPANY, {});
+      expect(result).toEqual(['user-1', 'user-2']);
